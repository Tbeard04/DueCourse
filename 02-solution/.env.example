# --- Required -----------------------------------------------------------
# Free key: https://developer.company-information.service.gov.uk/
CH_API_KEY=

# --- Optional: LLM drafting ----------------------------------------------
# If set, drafts use the Anthropic API (DRAFT_MODEL below).
ANTHROPIC_API_KEY=
# Fallback when no Anthropic key: a local Ollama server. With neither,
# drafts degrade to deterministic templates (triage/digest unaffected).
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: overrides --------------------------------------------------
DRAFT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5-5
DUECOURSE_DATA_DIR=data
# Bearer token required by the FastAPI surface (the n8n wrapper).
DUECOURSE_API_TOKEN=
